---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostUrl, estimateReadTime, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(p => !p.data.draft && p.data.series);
  const seriesNames = [...new Set(posts.map(p => p.data.series!))];
  return seriesNames.map(series => ({
    params: { series },
    props: { series },
  }));
}

const { series } = Astro.props;

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft && p.data.series === series)
  .sort((a, b) => (a.data.issue ?? 0) - (b.data.issue ?? 0));

const seriesLabel = series.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
---

<BaseLayout title={`${seriesLabel} — Series`} description={`All posts in the ${seriesLabel} series.`}>

  <section class="series-hero">
    <div class="container">
      <a href="/blog/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        All posts
      </a>
      <span class="series-eyebrow">Series</span>
      <h1 class="series-headline">{seriesLabel}</h1>
      <p class="series-intro">{posts.length} issue{posts.length !== 1 && 's'}</p>
    </div>
  </section>

  <section class="series-list">
    <div class="container">
      <div class="posts-list">
        {posts.map((post) => (
          <a href={getPostUrl(post)} class="series-card">
            <div class="series-card-issue">
              <span class="issue-number">{post.data.issue}</span>
            </div>
            <div class="series-card-inner">
              <div class="series-card-meta">
                <span class="series-card-date">{formatDate(post.data.date)}</span>
                <span class="meta-dot"></span>
                <span class="series-card-read">{estimateReadTime(post.body ?? '')} min</span>
              </div>
              <h2 class="series-card-title">{post.data.title}</h2>
              <p class="series-card-excerpt">{post.data.description}</p>
            </div>
            <div class="series-card-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .series-hero {
    padding-top: calc(var(--sp-16) + var(--sp-8));
    padding-bottom: var(--sp-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: var(--sp-6);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .series-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .series-headline {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.5rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-3);
  }

  .series-intro {
    font-size: 1.0625rem;
    color: var(--text-2);
  }

  .series-list {
    padding-top: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .series-card {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    text-decoration: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    padding: var(--sp-4);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-normal) var(--ease-out-expo);
  }

  .series-card:hover {
    border-color: var(--border-accent);
    box-shadow: 0 4px 20px var(--accent-glow);
    transform: translateX(4px);
    text-decoration: none;
  }

  .series-card-issue {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent-muted);
    border-radius: 4px;
    background: var(--accent-glow);
  }

  .issue-number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  .series-card-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .series-card-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex-wrap: wrap;
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .series-card-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .series-card:hover .series-card-title {
    color: var(--accent);
  }

  .series-card-excerpt {
    font-size: 0.875rem;
    color: var(--text-3);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .series-card-arrow {
    color: var(--text-3);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out-expo),
                transform var(--duration-normal) var(--ease-out-expo);
  }

  .series-card:hover .series-card-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .series-card-arrow {
      display: none;
    }
    .series-card-issue {
      display: none;
    }
  }
</style>
