---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostUrl, estimateReadTime, formatDate } from '../lib/posts';

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">

  <!-- ═══════════════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <!-- Layer 1: Geometric grid canvas (deepest) -->
    <canvas class="hero-grid-canvas" id="hero-grid-canvas"></canvas>
    <!-- Layer 2: Gradient mesh orbs -->
    <div class="hero-mesh" id="hero-mesh">
      <div class="mesh-orb mesh-orb-1"></div>
      <div class="mesh-orb mesh-orb-2"></div>
      <div class="mesh-orb mesh-orb-3"></div>
    </div>
    <!-- Layer 3: Content -->
    <div class="hero-inner container">
      <div class="hero-content">
        <span class="hero-eyebrow" id="hero-eyebrow">Builder // Founder // CEO</span>
        <h1 class="hero-title" id="hero-title">
          <span class="terminal-cursor" id="terminal-cursor"></span>
        </h1>
        <p class="hero-desc" id="hero-desc">
          Founder & CEO of Yirifi.ai — a 20-person AI regulatory intelligence startup.
          Former founding executive of TRUST Bank Singapore (1M+ clients) and Mox Bank Hong Kong (750K clients).
        </p>
        <div class="hero-actions" id="hero-actions">
          <a href="/blog/" class="btn btn-primary">
            <span>Read the Blog</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/about/" class="btn btn-outline">About Me</a>
        </div>
      </div>
      <div class="hero-coordinates">
        <span>01.2925&deg; N</span>
        <span>103.8519&deg; E</span>
      </div>
    </div>
    <div class="hero-scroll-hint" id="hero-scroll-hint">
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       ABOUT TEASER
       ═══════════════════════════════════════════════════════════ -->
  <section class="about-teaser" id="about">
    <div class="container">
      <div class="section-label">01 // About</div>
      <div class="about-grid">
        <div class="about-narrative">
          <p>
            Founder & CEO of <strong>Yirifi.ai</strong>, a 20-person AI regulatory intelligence startup
            where just two people built 15 backoffice microsites in three months. Author of
            <em>Blueprint for an AI-First Company</em>.
          </p>
          <p>
            Former founding executive of two digital banks — <strong>TRUST Bank</strong> Singapore
            (1M+ clients, ~20% market share) and <strong>Mox Bank</strong> Hong Kong
            (750K clients, 12% market share). 20+ years in banking and fintech across
            Standard Chartered and Citibank.
          </p>
          <a href="/about/" class="link-arrow">
            Read full bio
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="about-card">
          <div class="about-card-header">
            <span class="about-card-indicator"></span>
            At a Glance
          </div>
          <div class="about-card-grid">
            <div class="about-datum">
              <span class="datum-label">Role</span>
              <span class="datum-value">Founder & CEO</span>
            </div>
            <div class="about-datum">
              <span class="datum-label">Company</span>
              <span class="datum-value">Yirifi.ai</span>
            </div>
            <div class="about-datum">
              <span class="datum-label">Experience</span>
              <span class="datum-value">25+ Years</span>
            </div>
            <div class="about-datum">
              <span class="datum-label">Based in</span>
              <span class="datum-value">Singapore</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       BOOK FEATURE
       ═══════════════════════════════════════════════════════════ -->
  <section class="book" id="book">
    <div class="container">
      <div class="section-label">02 // The Book</div>
      <div class="book-card">
        <div class="book-card-content">
          <h2 class="book-title">Blueprint for an AI&#8209;First Company</h2>
          <p class="book-desc">
            A comprehensive playbook for founders and leaders building companies with AI at the core —
            from strategy and architecture to team design and go-to-market.
          </p>
          <a href="https://saurav-yirifi.github.io/blueprint-ai-first-company/" target="_blank" rel="noopener" class="link-arrow">
            Read the Book
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </a>
        </div>
        <div class="book-stats">
          <div class="book-stat">
            <span class="stat-number">81K<span class="stat-plus">+</span></span>
            <span class="stat-label">Words</span>
          </div>
          <div class="book-stat">
            <span class="stat-number">775</span>
            <span class="stat-label">Citations</span>
          </div>
          <div class="book-stat">
            <span class="stat-number">12</span>
            <span class="stat-label">Chapters</span>
          </div>
          <div class="book-stat">
            <span class="stat-number">20</span>
            <span class="stat-label">Frameworks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       LATEST WRITING
       ═══════════════════════════════════════════════════════════ -->
  <section class="writing" id="writing">
    <div class="container">
      <div class="section-label">03 // Latest Writing</div>
      <div class="posts-grid">
        {posts.map((post) => (
          <a href={getPostUrl(post)} class="post-card">
            <div class="post-card-inner">
              <span class="post-category">{post.data.tags[0]}</span>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              <div class="post-meta">
                <span>{formatDate(post.data.date)}</span>
                <span class="meta-dot"></span>
                <span>{estimateReadTime(post.body ?? '')} min read</span>
              </div>
            </div>
            <div class="post-card-edge"></div>
          </a>
        ))}
      </div>
      <div class="writing-footer">
        <a href="/blog/" class="link-arrow">
          View all posts
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT CTA
       ═══════════════════════════════════════════════════════════ -->
  <section class="contact-cta" id="connect">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">Let's Connect</h2>
        <p class="cta-desc">Whether it's about digital banking, crypto regulation, AI, or building ventures from scratch.</p>
        <a href="/contact/" class="btn btn-primary">
          <span>Send a Message</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ================================================================
     HERO
     ================================================================ */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0;
    background: var(--bg-void);
  }

  /* --- Layer 1: Geometric grid canvas --- */
  .hero-grid-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* --- Layer 2: Gradient mesh orbs --- */
  .hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    will-change: transform;
  }

  .mesh-orb-1 {
    width: 700px;
    height: 700px;
    background: var(--accent);
    opacity: 0.12;
    top: -15%;
    left: -10%;
    animation: mesh-drift-1 10s ease-in-out infinite;
  }

  .mesh-orb-2 {
    width: 500px;
    height: 500px;
    background: var(--accent-2, #8B5CF6);
    opacity: 0.1;
    bottom: -20%;
    right: -8%;
    animation: mesh-drift-2 13s ease-in-out infinite;
  }

  .mesh-orb-3 {
    width: 400px;
    height: 400px;
    background: var(--accent);
    opacity: 0.06;
    top: 40%;
    left: 45%;
    animation: mesh-drift-3 16s ease-in-out infinite;
  }

  @keyframes mesh-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    20% { transform: translate(18%, 12%) scale(1.15); }
    40% { transform: translate(8%, 25%) scale(0.9); }
    60% { transform: translate(-12%, 18%) scale(1.1); }
    80% { transform: translate(-5%, 5%) scale(1.05); }
  }

  @keyframes mesh-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    20% { transform: translate(-15%, -10%) scale(1.1); }
    40% { transform: translate(-25%, -20%) scale(0.85); }
    60% { transform: translate(-8%, -28%) scale(1.15); }
    80% { transform: translate(-18%, -8%) scale(0.95); }
  }

  @keyframes mesh-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
    25% { transform: translate(12%, -15%) scale(1.4) rotate(45deg); }
    50% { transform: translate(-8%, 10%) scale(0.7) rotate(90deg); }
    75% { transform: translate(15%, 5%) scale(1.2) rotate(135deg); }
  }

  /* --- Layer 3: Content --- */
  .hero-inner {
    position: relative;
    z-index: 5;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100dvh;
    padding-top: var(--sp-16);
    padding-bottom: var(--sp-8);
  }

  .hero-content {
    max-width: 52rem;
  }

  /* --- Eyebrow --- */
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-4);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out-expo);
  }

  .hero-eyebrow.visible {
    opacity: 1;
  }

  /* --- Title with typing effect --- */
  .hero-title {
    font-size: clamp(2.25rem, 5.5vw + 0.5rem, 4.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text-1);
    margin-bottom: var(--sp-4);
    min-height: 3.5em;
  }

  .hero-title .accent-word {
    color: var(--accent);
    position: relative;
  }

  .hero-title .accent-word::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    opacity: 0.3;
    border-radius: 1px;
  }

  .hero-title .em-word {
    font-style: italic;
    font-weight: 400;
  }

  .terminal-cursor {
    display: inline;
    animation: blink-cursor 0.8s step-end infinite;
    color: var(--accent);
  }

  .terminal-cursor::after {
    content: '█';
    font-size: 0.85em;
  }

  .terminal-cursor.hidden {
    display: none;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* --- Description & actions (fade in after typing) --- */
  .hero-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-2);
    max-width: 40rem;
    margin-bottom: var(--sp-6);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease-out-expo), transform 0.7s var(--ease-out-expo);
  }

  .hero-desc.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.7s var(--ease-out-expo), transform 0.7s var(--ease-out-expo);
  }

  .hero-actions.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Coordinates --- */
  .hero-coordinates {
    position: absolute;
    bottom: var(--sp-6);
    right: var(--sp-6);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-3);
    letter-spacing: 0.08em;
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out-expo);
  }

  .hero-coordinates.visible {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .hero-coordinates {
      display: flex;
    }
  }

  /* --- Scroll hint --- */
  .hero-scroll-hint {
    position: absolute;
    bottom: var(--sp-6);
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
  }

  .hero-scroll-hint.visible {
    opacity: 1;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent-muted), transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 1px;
    height: 8px;
    background: var(--accent);
    animation: scroll-pulse 2s var(--ease-out-expo) infinite;
    animation-delay: 2.5s;
  }

  @keyframes scroll-pulse {
    0% { top: -8px; opacity: 0; }
    20% { opacity: 1; }
    100% { top: 48px; opacity: 0; }
  }

  /* ================================================================
     BUTTONS
     ================================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo),
      background var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
    cursor: pointer;
  }

  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--accent);
    color: var(--bg-void);
    border: 1px solid var(--accent);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 24px var(--accent-glow), 0 0 0 1px var(--accent-muted);
    color: var(--bg-void);
  }

  .btn-outline {
    background: transparent;
    color: var(--text-1);
    border: 1px solid var(--border-hover);
  }

  .btn-outline:hover {
    border-color: var(--accent-muted);
    background: var(--accent-glow);
    transform: translateY(-2px);
    color: var(--text-1);
  }

  /* ================================================================
     LINK ARROW
     ================================================================ */
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: gap var(--duration-normal) var(--ease-out-expo);
  }

  .link-arrow:hover {
    gap: 12px;
    text-decoration: none;
  }

  /* ================================================================
     LATEST WRITING
     ================================================================ */
  .writing {
    border-top: 1px solid var(--border-default);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-3);
    }
  }

  .post-card {
    position: relative;
    display: block;
    text-decoration: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    overflow: hidden;
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 8px 32px var(--accent-glow);
    text-decoration: none;
  }

  .post-card-inner {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-height: 13rem;
  }

  .post-card-edge {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-muted), transparent);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }

  .post-card:hover .post-card-edge {
    opacity: 1;
  }

  .post-category {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    background: var(--accent-2-glow);
    padding: 3px 10px;
    border-radius: 2px;
    width: fit-content;
  }

  .post-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text-1);
    letter-spacing: -0.01em;
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: var(--text-3);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-top: auto;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border-default);
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .writing-footer {
    display: flex;
    justify-content: flex-end;
  }

  /* ================================================================
     ABOUT TEASER
     ================================================================ */
  .about-teaser {
    border-top: 1px solid var(--border-default);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 280px;
      gap: var(--sp-8);
    }
  }

  .about-narrative p {
    color: var(--text-2);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: var(--sp-3);
  }

  .about-narrative .link-arrow {
    margin-top: var(--sp-2);
  }

  .about-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    overflow: hidden;
  }

  .about-card-header {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .about-card-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-dim);
    animation: pulse-dot 3s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .about-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .about-datum {
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--border-default);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about-datum:nth-child(odd) {
    border-right: 1px solid var(--border-default);
  }

  .about-datum:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .datum-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .datum-value {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -0.01em;
  }

  /* ================================================================
     BOOK FEATURE
     ================================================================ */
  .book {
    border-top: 1px solid var(--border-default);
  }

  .book-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    position: relative;
  }

  .book-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-muted), transparent);
  }

  @media (min-width: 768px) {
    .book-card {
      grid-template-columns: 1fr 1fr;
    }
  }

  .book-card-content {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    justify-content: center;
  }

  .book-title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .book-desc {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .book-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border-default);
  }

  @media (min-width: 768px) {
    .book-stats {
      border-top: none;
      border-left: 1px solid var(--border-default);
    }
  }

  .book-stat {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-bottom: 1px solid var(--border-default);
    border-right: 1px solid var(--border-default);
  }

  .book-stat:nth-child(2n) {
    border-right: none;
  }

  .book-stat:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-plus {
    color: var(--accent);
    font-weight: 400;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ================================================================
     CONTACT CTA
     ================================================================ */
  .contact-cta {
    border-top: 1px solid var(--border-default);
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .cta-title {
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.75rem);
    letter-spacing: -0.03em;
  }

  .cta-desc {
    color: var(--text-2);
    font-size: 1rem;
    max-width: 32rem;
  }

  .cta-inner .btn {
    margin-top: var(--sp-2);
  }
</style>

<script>
  // ================================================================
  // TYPING EFFECT — types out the hero title, then reveals elements
  // ================================================================
  function initTypingHero() {
    const titleEl = document.getElementById('hero-title');
    const cursorEl = document.getElementById('terminal-cursor');
    const eyebrowEl = document.getElementById('hero-eyebrow');
    const descEl = document.getElementById('hero-desc');
    const actionsEl = document.getElementById('hero-actions');
    const coordsEl = document.querySelector('.hero-coordinates') as HTMLElement;
    const scrollHintEl = document.getElementById('hero-scroll-hint');

    if (!titleEl || !cursorEl) return;

    // The text segments to type — with markup hints
    const segments: { text: string; class?: string }[] = [
      { text: 'I ' },
      { text: 'build', class: 'accent-word' },
      { text: ' things at the\n' },
      { text: 'intersection of ' },
      { text: 'AI', class: 'em-word' },
      { text: ', ' },
      { text: 'Crypto', class: 'em-word' },
      { text: '\nand ' },
      { text: 'Finance', class: 'em-word' },
      { text: '.' },
    ];

    let segIndex = 0;
    let charIndex = 0;
    let currentSpan: HTMLSpanElement | null = null;

    function typeNext() {
      if (segIndex >= segments.length) {
        // Typing complete — reveal rest of hero
        setTimeout(() => {
          descEl?.classList.add('visible');
          setTimeout(() => {
            actionsEl?.classList.add('visible');
            setTimeout(() => {
              coordsEl?.classList.add('visible');
              scrollHintEl?.classList.add('visible');
            }, 300);
          }, 250);
        }, 400);

        // Hide cursor after a short pause
        setTimeout(() => {
          cursorEl?.classList.add('hidden');
        }, 2000);
        return;
      }

      const seg = segments[segIndex];

      // Create or reuse span for styled segments
      if (charIndex === 0 && seg.class) {
        currentSpan = document.createElement('span');
        currentSpan.className = seg.class;
        titleEl!.insertBefore(currentSpan, cursorEl);
      } else if (charIndex === 0 && !seg.class) {
        currentSpan = null;
      }

      const char = seg.text[charIndex];

      if (char === '\n') {
        const br = document.createElement('br');
        if (currentSpan) {
          currentSpan.appendChild(br);
        } else {
          titleEl!.insertBefore(br, cursorEl);
        }
      } else {
        const textNode = document.createTextNode(char);
        if (currentSpan) {
          currentSpan.appendChild(textNode);
        } else {
          titleEl!.insertBefore(textNode, cursorEl);
        }
      }

      charIndex++;

      if (charIndex >= seg.text.length) {
        segIndex++;
        charIndex = 0;
        currentSpan = null;
      }

      // Variable typing speed
      const delay = char === '\n' ? 150 : char === ' ' ? 40 : 30 + Math.random() * 35;
      setTimeout(typeNext, delay);
    }

    // Kick off sequence
    setTimeout(() => {
      eyebrowEl?.classList.add('visible');
      setTimeout(typeNext, 500);
    }, 300);
  }

  // ================================================================
  // GEOMETRIC GRID CANVAS — animated cell grid behind everything
  // ================================================================
  function initHeroGrid() {
    const canvas = document.getElementById('hero-grid-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let mouseX = -1000;
    let mouseY = -1000;
    const cellSize = 52;
    let cols = 0;
    let rows = 0;
    let cells: { brightness: number; target: number }[] = [];
    let time = 0;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * devicePixelRatio;
      canvas.height = height * devicePixelRatio;
      ctx!.scale(devicePixelRatio, devicePixelRatio);
      cols = Math.ceil(width / cellSize) + 1;
      rows = Math.ceil(height / cellSize) + 1;
      cells = new Array(cols * rows).fill(null).map(() => ({ brightness: 0, target: 0 }));
    }

    // Parse the computed accent color
    function getAccentRgb(): [number, number, number] {
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
      const r = parseInt(accent.slice(1, 3), 16);
      const g = parseInt(accent.slice(3, 5), 16);
      const b = parseInt(accent.slice(5, 7), 16);
      return [r, g, b];
    }

    let accentRgb = getAccentRgb();

    function draw() {
      ctx!.clearRect(0, 0, width, height);
      const [r, g, b] = accentRgb;
      time += 0.012;

      const centerX = width / 2;
      const centerY = height / 2;

      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const idx = row * cols + col;
          const x = col * cellSize;
          const y = row * cellSize;

          // Wave from center
          const distFromCenter = Math.sqrt(
            Math.pow((x - centerX) / width, 2) + Math.pow((y - centerY) / height, 2)
          );
          const wave = Math.sin(distFromCenter * 12 - time * 2) * 0.5 + 0.5;

          // Diagonal sweep
          const diagWave = Math.sin((col + row) * 0.3 - time * 1.5) * 0.5 + 0.5;

          // Mouse proximity
          const dx = x + cellSize / 2 - mouseX;
          const dy = y + cellSize / 2 - mouseY;
          const mouseDist = Math.sqrt(dx * dx + dy * dy);
          const mouseInfluence = Math.max(0, 1 - mouseDist / 200);

          // Combine
          cells[idx].target = Math.min(1, wave * 0.1 + diagWave * 0.05 + mouseInfluence * 0.45);

          // Smooth interpolation
          cells[idx].brightness += (cells[idx].target - cells[idx].brightness) * 0.06;

          const alpha = cells[idx].brightness;
          if (alpha > 0.01) {
            // Cell border
            ctx!.strokeStyle = `rgba(${r},${g},${b},${alpha * 0.25})`;
            ctx!.lineWidth = 0.5;
            ctx!.strokeRect(x + 0.5, y + 0.5, cellSize - 1, cellSize - 1);

            // Cell fill
            if (alpha > 0.04) {
              ctx!.fillStyle = `rgba(${r},${g},${b},${alpha * 0.04})`;
              ctx!.fillRect(x + 1, y + 1, cellSize - 2, cellSize - 2);
            }

            // Corner dots on bright cells
            if (alpha > 0.12) {
              ctx!.fillStyle = `rgba(${r},${g},${b},${alpha * 0.5})`;
              const dotSize = 1.5;
              ctx!.fillRect(x, y, dotSize, dotSize);
              ctx!.fillRect(x + cellSize - dotSize, y, dotSize, dotSize);
              ctx!.fillRect(x, y + cellSize - dotSize, dotSize, dotSize);
              ctx!.fillRect(x + cellSize - dotSize, y + cellSize - dotSize, dotSize, dotSize);
            }
          }
        }
      }

      // Pulse wave
      const pulsePhase = (time * 0.4) % (Math.PI * 2);
      const pulseRadius = (Math.sin(pulsePhase) * 0.5 + 0.5) * Math.max(width, height) * 0.7;
      const pulseWidth = 100;

      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < cols; col++) {
          const x = col * cellSize + cellSize / 2;
          const y = row * cellSize + cellSize / 2;
          const dist = Math.sqrt(Math.pow(x - centerX, 2) + Math.pow(y - centerY, 2));
          const pulseDist = Math.abs(dist - pulseRadius);
          if (pulseDist < pulseWidth) {
            const pulseAlpha = (1 - pulseDist / pulseWidth) * 0.06;
            ctx!.fillStyle = `rgba(${r},${g},${b},${pulseAlpha})`;
            ctx!.fillRect(col * cellSize, row * cellSize, cellSize, cellSize);
          }
        }
      }

      requestAnimationFrame(draw);
    }

    resize();
    draw();

    window.addEventListener('resize', () => {
      resize();
      accentRgb = getAccentRgb();
    });

    const hero = document.getElementById('hero');
    hero?.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });

    hero?.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
    });
  }

  // ================================================================
  // MESH ORBS — mouse parallax
  // ================================================================
  function initMeshParallax() {
    const mesh = document.getElementById('hero-mesh');
    if (!mesh) return;
    const hero = document.getElementById('hero');
    const orbs = mesh.querySelectorAll('.mesh-orb') as NodeListOf<HTMLElement>;

    hero?.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      orbs.forEach((orb, i) => {
        const factor = (i + 1) * 20;
        orb.style.marginLeft = `${x * factor}px`;
        orb.style.marginTop = `${y * factor}px`;
      });
    });
  }

  // ================================================================
  // SCROLL REVEAL — IntersectionObserver for below-fold sections
  // ================================================================
  function initScrollReveal() {
    const revealTargets = document.querySelectorAll('.writing, .about-teaser, .book, .contact-cta');

    const revealChildren = (section: Element) => {
      const elements = section.querySelectorAll('.section-label, .post-card, .about-narrative, .about-card, .book-card, .cta-inner, .writing-footer');
      elements.forEach((el, i) => {
        (el as HTMLElement).style.opacity = '0';
        (el as HTMLElement).style.transform = 'translateY(24px)';
        (el as HTMLElement).style.transition = `opacity 0.6s ${0.08 * i}s var(--ease-out-expo), transform 0.6s ${0.08 * i}s var(--ease-out-expo)`;
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const children = entry.target.querySelectorAll('.section-label, .post-card, .about-narrative, .about-card, .book-card, .cta-inner, .writing-footer');
          children.forEach(el => {
            (el as HTMLElement).style.opacity = '1';
            (el as HTMLElement).style.transform = 'translateY(0)';
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '-40px' });

    revealTargets.forEach(section => {
      revealChildren(section);
      observer.observe(section);
    });
  }

  // ================================================================
  // INIT ALL
  // ================================================================
  initHeroGrid();
  initMeshParallax();
  initTypingHero();
  initScrollReveal();
</script>
