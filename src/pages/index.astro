---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function estimateReadTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 250));
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout title="Home">

  <!-- ═══════════════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="hero-glow" id="hero-glow"></div>
    <div class="hero-grid-overlay"></div>
    <div class="hero-scanline"></div>
    <div class="hero-inner container">
      <div class="hero-content">
        <span class="hero-eyebrow">Builder // Founder // CEO</span>
        <h1 class="hero-title">
          I <span class="cyan">build</span> things at the<br />
          intersection of <span class="hero-title-em">AI</span> and <span class="hero-title-em">finance</span>.
        </h1>
        <p class="hero-desc">
          Founder & CEO of Yirifi.ai — building AI-powered regulatory intelligence for crypto and fintech.
          Previously founded two digital banks across Asia.
        </p>
        <div class="hero-actions">
          <a href="/blog/" class="btn btn-primary">
            <span>Read the Blog</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/about/" class="btn btn-outline">About Me</a>
        </div>
      </div>
      <div class="hero-coordinates">
        <span>01.2925&deg; N</span>
        <span>103.8519&deg; E</span>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       LATEST WRITING
       ═══════════════════════════════════════════════════════════ -->
  <section class="writing" id="writing">
    <div class="container">
      <div class="section-label">01 // Latest Writing</div>
      <div class="posts-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="post-card-inner">
              <span class="post-category">{post.data.category}</span>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-excerpt">{post.data.description}</p>
              <div class="post-meta">
                <span>{formatDate(post.data.date)}</span>
                <span class="meta-dot"></span>
                <span>{estimateReadTime(post.body ?? '')} min read</span>
              </div>
            </div>
            <div class="post-card-edge"></div>
          </a>
        ))}
      </div>
      <div class="writing-footer">
        <a href="/blog/" class="link-arrow">
          View all posts
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       ABOUT TEASER
       ═══════════════════════════════════════════════════════════ -->
  <section class="about-teaser" id="about">
    <div class="container">
      <div class="section-label">02 // About</div>
      <div class="about-grid">
        <div class="about-narrative">
          <p>
            I've spent 25+ years at the intersection of banking, technology, and venture building.
            As the founding executive behind <strong>TRUST Bank</strong> (Singapore's first digital bank — 450K clients
            in four months) and <strong>Mox Bank</strong> (Hong Kong — most downloaded app, $1.2B deposits),
            I know what it takes to build financial products from zero to scale.
          </p>
          <p>
            Now I'm building <strong>Yirifi.ai</strong>, an AI-powered regulatory intelligence platform
            helping financial institutions navigate the rapidly shifting crypto and fintech landscape.
            My team of two shipped 15 AI microsites in three months.
          </p>
          <a href="/about/" class="link-arrow">
            Read full bio
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="about-card">
          <div class="about-card-header">
            <span class="about-card-indicator"></span>
            At a Glance
          </div>
          <div class="about-card-grid">
            <div class="about-datum">
              <span class="datum-label">Role</span>
              <span class="datum-value">Founder & CEO</span>
            </div>
            <div class="about-datum">
              <span class="datum-label">Company</span>
              <span class="datum-value">Yirifi.ai</span>
            </div>
            <div class="about-datum">
              <span class="datum-label">Experience</span>
              <span class="datum-value">25+ Years</span>
            </div>
            <div class="about-datum">
              <span class="datum-label">Based in</span>
              <span class="datum-value">Singapore</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       BOOK FEATURE
       ═══════════════════════════════════════════════════════════ -->
  <section class="book" id="book">
    <div class="container">
      <div class="section-label">03 // The Book</div>
      <div class="book-card">
        <div class="book-card-content">
          <h2 class="book-title">Blueprint for an AI&#8209;First Company</h2>
          <p class="book-desc">
            A comprehensive playbook for founders and leaders building companies with AI at the core —
            from strategy and architecture to team design and go-to-market.
          </p>
          <a href="https://saurav-yirifi.github.io/blueprint-ai-first-company/" target="_blank" rel="noopener" class="link-arrow">
            Read the Book
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </a>
        </div>
        <div class="book-stats">
          <div class="book-stat">
            <span class="stat-number">81K<span class="stat-plus">+</span></span>
            <span class="stat-label">Words</span>
          </div>
          <div class="book-stat">
            <span class="stat-number">775</span>
            <span class="stat-label">Citations</span>
          </div>
          <div class="book-stat">
            <span class="stat-number">12</span>
            <span class="stat-label">Chapters</span>
          </div>
          <div class="book-stat">
            <span class="stat-number">20</span>
            <span class="stat-label">Frameworks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT CTA
       ═══════════════════════════════════════════════════════════ -->
  <section class="contact-cta" id="connect">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">Let's Connect</h2>
        <p class="cta-desc">Whether it's about digital banking, crypto regulation, AI, or building ventures from scratch.</p>
        <a href="/contact/" class="btn btn-primary">
          <span>Send a Message</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ================================================================
     HERO
     ================================================================ */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    transition: background 0.08s linear;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.025;
    background-image:
      linear-gradient(var(--accent-muted) 1px, transparent 1px),
      linear-gradient(90deg, var(--accent-muted) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 70%);
  }

  .hero-scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-dim), transparent);
    opacity: 0;
    z-index: 2;
    animation: scanline 4s var(--ease-out-expo) infinite;
    animation-delay: 2s;
  }

  @keyframes scanline {
    0% { top: 0; opacity: 0; }
    5% { opacity: 0.4; }
    95% { opacity: 0.1; }
    100% { top: 100%; opacity: 0; }
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100dvh;
    padding-top: var(--sp-16);
    padding-bottom: var(--sp-8);
  }

  .hero-content {
    max-width: 52rem;
  }

  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-4);
    opacity: 0;
    transform: translateY(20px);
    animation: hero-reveal 0.8s var(--ease-out-expo) 0.2s forwards;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5.5vw + 0.5rem, 4.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text-1);
    margin-bottom: var(--sp-4);
    opacity: 0;
    transform: translateY(24px);
    animation: hero-reveal 0.9s var(--ease-out-expo) 0.35s forwards;
  }

  .hero-title .cyan {
    color: var(--accent);
    position: relative;
  }

  .hero-title .cyan::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    opacity: 0.3;
    border-radius: 1px;
  }

  .hero-title-em {
    font-style: italic;
    font-weight: 400;
  }

  .hero-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-2);
    max-width: 40rem;
    margin-bottom: var(--sp-6);
    opacity: 0;
    transform: translateY(20px);
    animation: hero-reveal 0.8s var(--ease-out-expo) 0.55s forwards;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(16px);
    animation: hero-reveal 0.7s var(--ease-out-expo) 0.72s forwards;
  }

  .hero-coordinates {
    position: absolute;
    bottom: var(--sp-6);
    right: var(--sp-6);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-3);
    letter-spacing: 0.08em;
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    opacity: 0;
    animation: hero-reveal 0.6s var(--ease-out-expo) 1.2s forwards;
  }

  @media (min-width: 1024px) {
    .hero-coordinates {
      display: flex;
    }
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: var(--sp-6);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    opacity: 0;
    animation: hero-reveal 0.5s var(--ease-out-expo) 1.4s forwards;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent-muted), transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 1px;
    height: 8px;
    background: var(--accent);
    animation: scroll-pulse 2s var(--ease-out-expo) infinite;
    animation-delay: 2.5s;
  }

  @keyframes scroll-pulse {
    0% { top: -8px; opacity: 0; }
    20% { opacity: 1; }
    100% { top: 48px; opacity: 0; }
  }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ================================================================
     BUTTONS
     ================================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo),
      background var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo);
    cursor: pointer;
  }

  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--accent);
    color: var(--bg-void);
    border: 1px solid var(--accent);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 24px var(--accent-glow), 0 0 0 1px var(--accent-muted);
    color: var(--bg-void);
  }

  .btn-outline {
    background: transparent;
    color: var(--text-1);
    border: 1px solid var(--border-hover);
  }

  .btn-outline:hover {
    border-color: var(--accent-muted);
    background: var(--accent-glow);
    transform: translateY(-2px);
    color: var(--text-1);
  }

  /* ================================================================
     LINK ARROW
     ================================================================ */
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: gap var(--duration-normal) var(--ease-out-expo);
  }

  .link-arrow:hover {
    gap: 12px;
    text-decoration: none;
  }

  /* ================================================================
     LATEST WRITING
     ================================================================ */
  .writing {
    border-top: 1px solid var(--border-default);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-3);
    }
  }

  .post-card {
    position: relative;
    display: block;
    text-decoration: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    overflow: hidden;
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 8px 32px var(--accent-glow);
    text-decoration: none;
  }

  .post-card-inner {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-height: 13rem;
  }

  .post-card-edge {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-muted), transparent);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }

  .post-card:hover .post-card-edge {
    opacity: 1;
  }

  .post-category {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    background: var(--accent-2-glow);
    padding: 3px 10px;
    border-radius: 2px;
    width: fit-content;
  }

  .post-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text-1);
    letter-spacing: -0.01em;
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-excerpt {
    font-size: 0.875rem;
    color: var(--text-3);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-top: auto;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border-default);
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .writing-footer {
    display: flex;
    justify-content: flex-end;
  }

  /* ================================================================
     ABOUT TEASER
     ================================================================ */
  .about-teaser {
    border-top: 1px solid var(--border-default);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 280px;
      gap: var(--sp-8);
    }
  }

  .about-narrative p {
    color: var(--text-2);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: var(--sp-3);
  }

  .about-narrative .link-arrow {
    margin-top: var(--sp-2);
  }

  .about-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    overflow: hidden;
  }

  .about-card-header {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .about-card-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-dim);
    animation: pulse-dot 3s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .about-card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .about-datum {
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--border-default);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about-datum:nth-child(odd) {
    border-right: 1px solid var(--border-default);
  }

  .about-datum:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .datum-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .datum-value {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -0.01em;
  }

  /* ================================================================
     BOOK FEATURE
     ================================================================ */
  .book {
    border-top: 1px solid var(--border-default);
  }

  .book-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    position: relative;
  }

  .book-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-muted), transparent);
  }

  @media (min-width: 768px) {
    .book-card {
      grid-template-columns: 1fr 1fr;
    }
  }

  .book-card-content {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    justify-content: center;
  }

  .book-title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .book-desc {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .book-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border-default);
  }

  @media (min-width: 768px) {
    .book-stats {
      border-top: none;
      border-left: 1px solid var(--border-default);
    }
  }

  .book-stat {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-bottom: 1px solid var(--border-default);
    border-right: 1px solid var(--border-default);
  }

  .book-stat:nth-child(2n) {
    border-right: none;
  }

  .book-stat:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--text-1);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-plus {
    color: var(--accent);
    font-weight: 400;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ================================================================
     CONTACT CTA
     ================================================================ */
  .contact-cta {
    border-top: 1px solid var(--border-default);
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .cta-title {
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.75rem);
    letter-spacing: -0.03em;
  }

  .cta-desc {
    color: var(--text-2);
    font-size: 1rem;
    max-width: 32rem;
  }

  .cta-inner .btn {
    margin-top: var(--sp-2);
  }
</style>

<script>
  // Cursor glow — tracks mouse on the hero section
  const hero = document.getElementById('hero');
  const glow = document.getElementById('hero-glow');

  if (hero && glow && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      glow.style.background = `radial-gradient(600px circle at ${x}px ${y}px, var(--accent-glow), transparent 60%)`;
    });

    hero.addEventListener('mouseleave', () => {
      glow.style.background = 'none';
    });
  }

  // Scroll reveal — IntersectionObserver for sections
  const revealTargets = document.querySelectorAll('.writing, .about-teaser, .book, .contact-cta');
  const revealChildren = (section: Element) => {
    const elements = section.querySelectorAll('.section-label, .post-card, .about-narrative, .about-card, .book-card, .cta-inner, .writing-footer');
    elements.forEach((el, i) => {
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(24px)';
      (el as HTMLElement).style.transition = `opacity 0.6s ${0.08 * i}s var(--ease-out-expo), transform 0.6s ${0.08 * i}s var(--ease-out-expo)`;
    });
    return elements;
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const children = entry.target.querySelectorAll('.section-label, .post-card, .about-narrative, .about-card, .book-card, .cta-inner, .writing-footer');
        children.forEach(el => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'translateY(0)';
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '-40px' });

  revealTargets.forEach(section => {
    revealChildren(section);
    observer.observe(section);
  });
</script>
