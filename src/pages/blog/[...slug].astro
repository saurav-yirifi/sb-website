---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const currentIndex = allPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

function estimateReadTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 250));
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>

  <article class="post">
    <div class="container">
      <div class="post-header">
        <a href="/blog/" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          All posts
        </a>
        <div class="post-meta">
          <span class="post-category">{post.data.category}</span>
          <span class="post-date">{formatDate(post.data.date)}</span>
          <span class="meta-sep">&middot;</span>
          <span class="post-read">{estimateReadTime(post.body ?? '')} min read</span>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
      </div>

      <div class="post-content prose">
        <Content />
      </div>

      {(prevPost || nextPost) && (
        <nav class="post-nav">
          {prevPost ? (
            <a href={`/blog/${prevPost.id}/`} class="post-nav-link prev">
              <span class="post-nav-label">Previous</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`/blog/${nextPost.id}/`} class="post-nav-link next">
              <span class="post-nav-label">Next</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          ) : <div />}
        </nav>
      )}
    </div>
  </article>

</BaseLayout>

<style>
  .post {
    padding-top: calc(var(--sp-16) + var(--sp-8));
  }

  .post-header {
    max-width: var(--content-width);
    margin-bottom: var(--sp-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: var(--sp-6);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
    flex-wrap: wrap;
  }

  .post-category {
    color: var(--accent-2);
  }

  .meta-sep {
    color: var(--text-3);
  }

  .post-title {
    font-size: clamp(1.75rem, 4vw + 0.5rem, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  /* Prose — blog content styling */
  .post-content {
    max-width: var(--content-width);
  }

  .post-content :global(h2) {
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-3);
  }

  .post-content :global(h3) {
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-2);
  }

  .post-content :global(p) {
    margin-bottom: var(--sp-3);
    max-width: none;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--sp-3);
    padding-left: var(--sp-4);
    color: var(--text-2);
  }

  .post-content :global(li) {
    margin-bottom: var(--sp-1);
  }

  .post-content :global(img) {
    border-radius: 4px;
    margin: var(--sp-4) 0;
    border: 1px solid var(--border-default);
  }

  .post-content :global(blockquote) {
    margin: var(--sp-4) 0;
  }

  .post-content :global(a) {
    text-underline-offset: 3px;
    text-decoration: underline;
    text-decoration-color: var(--accent-muted);
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .post-content :global(hr) {
    margin: var(--sp-6) 0;
  }

  .post-content :global(strong) {
    color: var(--text-1);
  }

  /* Post navigation */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border-default);
    max-width: var(--content-width);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    padding: var(--sp-3);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      background var(--duration-fast) var(--ease-out-expo);
  }

  .post-nav-link:hover {
    border-color: var(--border-accent);
    background: var(--bg-surface);
    text-decoration: none;
  }

  .post-nav-link.next {
    text-align: right;
  }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .post-nav-title {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-1);
    letter-spacing: -0.01em;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent);
  }
</style>
