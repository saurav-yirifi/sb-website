---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostUrl, estimateReadTime, formatDate } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(p => !p.data.draft);
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  return tags.map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft && p.data.tags.includes(tag))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`${tag} — Blog`} description={`Posts tagged "${tag}".`}>

  <section class="blog-hero">
    <div class="container">
      <a href="/blog/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        All posts
      </a>
      <span class="blog-eyebrow">Tag</span>
      <h1 class="blog-headline">{tag}</h1>
      <p class="blog-intro">{posts.length} post{posts.length !== 1 && 's'}</p>
    </div>
  </section>

  <section class="blog-list">
    <div class="container">
      <div class="posts-list">
        {posts.map((post) => (
          <a href={getPostUrl(post)} class="blog-card">
            <div class="blog-card-inner">
              <div class="blog-card-meta">
                <span class="blog-card-tags">
                  {post.data.tags.map((t, i) => (
                    <>{i > 0 && <span class="tag-sep">/</span>}<span class:list={['tag-label', { 'tag-active': t === tag }]}>{t}</span></>
                  ))}
                </span>
                <span class="blog-card-date">{formatDate(post.data.date)}</span>
                <span class="meta-dot"></span>
                <span class="blog-card-read">{estimateReadTime(post.body ?? '')} min</span>
              </div>
              <h2 class="blog-card-title">{post.data.title}</h2>
              <p class="blog-card-excerpt">{post.data.description}</p>
            </div>
            <div class="blog-card-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .blog-hero {
    padding-top: calc(var(--sp-16) + var(--sp-8));
    padding-bottom: var(--sp-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: var(--sp-6);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .blog-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .blog-headline {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.5rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-3);
    text-transform: capitalize;
  }

  .blog-intro {
    font-size: 1.0625rem;
    color: var(--text-2);
  }

  .blog-list {
    padding-top: 0;
  }

  /* Post Cards */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .blog-card {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    text-decoration: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    padding: var(--sp-4);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-normal) var(--ease-out-expo);
  }

  .blog-card:hover {
    border-color: var(--border-accent);
    box-shadow: 0 4px 20px var(--accent-glow);
    transform: translateX(4px);
    text-decoration: none;
  }

  .blog-card-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .blog-card-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex-wrap: wrap;
  }

  .blog-card-tags .tag-label {
    color: var(--accent-2);
  }

  .blog-card-tags .tag-label.tag-active {
    color: var(--accent);
  }

  .blog-card-tags .tag-sep {
    color: var(--text-3);
    margin: 0 2px;
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .blog-card-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) var(--ease-out-expo);
  }

  .blog-card:hover .blog-card-title {
    color: var(--accent);
  }

  .blog-card-excerpt {
    font-size: 0.875rem;
    color: var(--text-3);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-arrow {
    color: var(--text-3);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out-expo),
                transform var(--duration-normal) var(--ease-out-expo);
  }

  .blog-card:hover .blog-card-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .blog-card-arrow {
      display: none;
    }
  }
</style>
