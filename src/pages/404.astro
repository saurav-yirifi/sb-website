---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="not-found">
    <div class="container">
      <span class="nf-code">404</span>
      <h1 class="nf-title">Page not found</h1>
      <p class="nf-desc">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="nf-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back to home
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 80dvh;
    display: flex;
    align-items: center;
    padding-top: var(--sp-16);
  }

  .nf-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: var(--sp-3);
  }

  .nf-title {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-2);
  }

  .nf-desc {
    color: var(--text-2);
    margin-bottom: var(--sp-6);
  }

  .nf-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: gap var(--duration-normal) var(--ease-out-expo);
  }

  .nf-link:hover {
    gap: 10px;
    text-decoration: none;
  }
</style>
